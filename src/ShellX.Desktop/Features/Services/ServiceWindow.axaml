<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShellX.Desktop.Features.Services" xmlns:core="using:ShellX.Core.Services"
        x:Class="ShellX.Desktop.Features.Services.ServiceWindow" x:DataType="vm:ServiceWindowViewModel"
        Title="服务状态" Width="960" Height="640" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}">
  <Grid RowDefinitions="Auto,*,Auto,210">
    <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,9">
      <Grid ColumnDefinitions="*,260,Auto" ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="服务状态" FontSize="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Target}" FontSize="10" Foreground="{DynamicResource MutedForeground}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Target}" />
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="搜索服务名或描述…"
                 VerticalAlignment="Center" Padding="8,5" />
        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="8,6">
      <DataGrid x:Name="ServiceGrid" ItemsSource="{Binding VisibleServices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserSortColumns="True"
                GridLinesVisibility="Horizontal" HeadersVisibility="Column" FontSize="12" RowHeight="28"
                HorizontalScrollBarVisibility="Disabled">
        <DataGrid.Columns>
          <DataGridTextColumn Header="服务" Binding="{Binding Unit}" Width="280" SortMemberPath="Unit" />
          <DataGridTemplateColumn Header="状态" Width="150" SortMemberPath="StateText">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="core:RemoteService">
                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="开机" Binding="{Binding EnabledText}" Width="118" SortMemberPath="EnabledText" />
          <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding HasEmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource MutedForeground}" FontSize="12" />
    </Grid>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBackground}" Padding="10,7">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="启动" Command="{Binding StartCommand}" />
          <Button Content="停止" Command="{Binding StopCommand}" />
          <Button Content="重启" Command="{Binding RestartCommand}" />
          <Button Content="启用" Command="{Binding EnableCommand}" Classes="flat" />
          <Button Content="禁用" Command="{Binding DisableCommand}" Classes="flat" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource MutedForeground}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" RowDefinitions="Auto,*" Margin="10,7,10,10">
      <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" Margin="0,0,0,5" />
      <TextBox Grid.Row="1" Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               FontFamily="Consolas,Microsoft YaHei UI" FontSize="11" MinHeight="90"
               Background="{DynamicResource TreeBackground}" BorderBrush="{DynamicResource BorderColor}" Padding="10,7"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
  </Grid>
</Window>