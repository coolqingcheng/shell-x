<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.Commands" x:DataType="vm:CommandPanelViewModel" xmlns:models="using:ShellX.Core.Commands" xmlns:controls="using:ShellX.Desktop.Controls" x:Class="ShellX.Desktop.Features.Commands.CommandPanelView">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="1" Background="{DynamicResource BorderColor}">
    <DockPanel Background="{DynamicResource AppBackground}">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,5"><TextBlock Text="快捷命令" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="flat" Command="{Binding AddQuickCommand}" FontSize="11" Padding="8,5"><StackPanel Orientation="Horizontal" Spacing="5"><controls:StrokeIcon Symbol="plus" Width="14" Height="14" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="添加" VerticalAlignment="Center" /></StackPanel></Button></Grid>
      <TextBlock DockPanel.Dock="Bottom" Text="快捷命令随连接保存；点击填入或执行。" Foreground="{DynamicResource MutedForeground}" FontSize="10" Margin="12,6" />
      <ScrollViewer><ItemsControl ItemsSource="{Binding QuickCommands}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SavedCommand">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,6" ColumnSpacing="6">
          <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontSize="12" /><TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource CommandForeground}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" /></StackPanel>
          <Button Grid.Column="1" Content="填入" Classes="flat" FontSize="11" Command="{Binding $parent[UserControl].((vm:CommandPanelViewModel)DataContext).FillCommand}" CommandParameter="{Binding Text}" />
          <Button Grid.Column="2" Content="执行" Classes="flat" FontSize="11" Command="{Binding $parent[UserControl].((vm:CommandPanelViewModel)DataContext).ExecuteQuickCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[UserControl].((vm:CommandPanelViewModel)DataContext).IsAvailable}" />
          <Button Grid.Column="3" Classes="flat" Command="{Binding $parent[UserControl].((vm:CommandPanelViewModel)DataContext).RemoveQuickCommand}" CommandParameter="{Binding}" ToolTip.Tip="删除快捷命令" Padding="6,4"><controls:StrokeIcon Symbol="close" Width="14" Height="14" /></Button>
        </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
    <DockPanel Grid.Column="1" Background="{DynamicResource AppBackground}">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,5"><TextBlock Text="命令历史" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" Content="清空" Classes="flat" Command="{Binding ClearHistoryCommand}" FontSize="11" /></Grid>
      <TextBlock DockPanel.Dock="Bottom" Text="仅保留本标签主动发送的最近 200 条命令。" Foreground="{DynamicResource MutedForeground}" FontSize="10" Margin="12,6" />
      <ScrollViewer><ItemsControl ItemsSource="{Binding History}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CommandHistoryEntry">
        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,6" Command="{Binding $parent[UserControl].((vm:CommandPanelViewModel)DataContext).FillCommand}" CommandParameter="{Binding Text}">
          <Grid ColumnDefinitions="65,*" ColumnSpacing="6"><TextBlock Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource MutedForeground}" /><TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" /></Grid>
        </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
