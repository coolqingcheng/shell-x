<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.Shell" x:DataType="vm:MainWindowViewModel"
        xmlns:workspace="using:ShellX.Desktop.Features.Workspace" xmlns:connections="using:ShellX.Desktop.Features.Connections"
        xmlns:monitor="using:ShellX.Desktop.Features.Monitoring" xmlns:controls="using:ShellX.Desktop.Controls" xmlns:browser="using:ShellX.Desktop.Features.FileBrowser"
        x:Class="ShellX.Desktop.Features.Shell.MainWindow" x:Name="Root"
        Title="ShellX" Icon="/Assets/ShellX.ico" Width="1380" Height="900" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewConnectionCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleConnectionsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding SelectedTab.CloseCommand}" />
  </Window.KeyBindings>
  <Grid x:Name="RootLayout" RowDefinitions="36,*,24" ColumnDefinitions="220,4,*,4,320">
    <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource RaisedBackground}" BorderThickness="0,0,1,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,6,0" IsVisible="{Binding !IsMonitorPaneCollapsed}">
          <Image Source="/Assets/ShellX.png" Width="18" Height="18" />
          <TextBlock Name="BrandName" Text="ShellX" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{Binding VersionText, StringFormat='ShellX {0}'}" />
          <TextBlock Name="BrandVersion" Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
          <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
          <Button Name="CollapseMonitorPane" Classes="flat" Command="{Binding ToggleMonitorPaneCommand}" Padding="4,2" ToolTip.Tip="收起服务器状态面板">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:StrokeIcon Symbol="chevron-left" Width="14" Height="14" VerticalAlignment="Center" />
              <TextBlock Text="服务器状态" FontSize="12" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Name="ExpandMonitorPane" Classes="flat" IsVisible="{Binding IsMonitorPaneCollapsed}" Command="{Binding ToggleMonitorPaneCommand}"
                ToolTip.Tip="展开服务器状态面板" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2">
          <controls:StrokeIcon Symbol="chevron-right" Width="16" Height="16" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Column="1" Grid.ColumnSpan="3" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="42,*,32,32,Auto,32,32">
        <Button Name="OpenConnectionManager" Classes="flat icon" Command="{Binding ToggleConnectionsCommand}" ToolTip.Tip="打开连接管理  Ctrl+B" Foreground="{DynamicResource AccentForeground}" Width="28" Height="28" Margin="7,0" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:StrokeIcon Symbol="connections" Width="20" Height="20" Foreground="{DynamicResource AccentForeground}" /></Button>
        <ListBox Name="ConnectionTabs" Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Classes="shelltabs">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="workspace:WorkspaceTabViewModel">
              <controls:ShellTabItemView Title="{Binding Name}" StatusColor="{Binding StatusColor}" AccentColor="{Binding AccentColor}"
                                         IsActive="{Binding IsSelected}" CloseCommand="{Binding CloseCommand}" CloseToolTip="关闭标签" TitleMaxWidth="180">
                <controls:ShellTabItemView.ContextMenu>
                  <ContextMenu><MenuItem Header="重命名标签…" Command="{Binding RenameCommand}" /><Separator /><MenuItem Header="关闭标签" Command="{Binding CloseCommand}" /></ContextMenu>
                </controls:ShellTabItemView.ContextMenu>
              </controls:ShellTabItemView>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="2" Classes="flat icon" Command="{Binding NewConnectionCommand}" ToolTip.Tip="新建连接  Ctrl+N" Width="28" Height="28" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:StrokeIcon Symbol="plus" Width="20" Height="20" /></Button>
        <Button Name="ResetLayout" Grid.Column="3" Classes="flat icon" Command="{Binding ResetLayoutCommand}" ToolTip.Tip="恢复默认布局" Width="28" Height="28" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:StrokeIcon Symbol="layout" Width="18" Height="18" /></Button><Button Name="OpenMcpLog" Grid.Column="4" Content="MCP 日志" IsVisible="{Binding HasMcpConnections}" MinWidth="72" Click="ShowMcpLog" ToolTip.Tip="查看 MCP 命令执行日志" Padding="3,0" FontSize="10" /><Button Name="ThemeSwitch" Grid.Column="5" Classes="flat icon" Click="ShowThemeMenu" ToolTip.Tip="切换主题" Width="28" Height="28" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:StrokeIcon Symbol="palette" Width="18" Height="18" /></Button><Button Grid.Column="6" Classes="flat icon" Command="{Binding SettingsCommand}" ToolTip.Tip="设置" Width="28" Height="28" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center"><controls:StrokeIcon Symbol="settings" Width="18" Height="18" /></Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Background="{DynamicResource PanelBackground}">
      <Grid IsVisible="{Binding !IsMonitorPaneCollapsed}">
        <Border IsVisible="{Binding HasTabs}"><monitor:ServerMonitorView DataContext="{Binding SelectedTab.Monitor}" /></Border>
        <TextBlock IsVisible="{Binding HasNoTabs}" Text="连接后显示服务器状态" Foreground="{DynamicResource MutedForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <GridSplitter x:Name="MonitorSplitter" Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource BorderColor}" DragCompleted="MonitorSplitterDragCompleted" />
    <Grid Grid.Row="1" Grid.Column="2">
      <StackPanel IsVisible="{Binding HasNoTabs}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Spacing="20" Margin="32">
        <Image Source="/Assets/ShellX.png" Width="80" Height="80" Margin="0,0,0,8" HorizontalAlignment="Center" />
        <TextBlock Text="ShellX" FontSize="36" FontWeight="Light" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="终端、文件与服务器状态，集中在一个工作区。" Foreground="{DynamicResource MutedForeground}" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" />
        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,4" />
        <Button Content="打开连接管理器" Classes="primary" Command="{Binding ToggleConnectionsCommand}" HorizontalAlignment="Center" />
        <TextBlock Text="点击顶部文件夹管理连接，连接后左侧显示实时监控。" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="密码 / 私钥认证 · 多标签 · SFTP · 端口转发" FontSize="11" Foreground="{DynamicResource PlaceholderForeground}" HorizontalAlignment="Center" TextAlignment="Center" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Tabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:WorkspaceTabViewModel"><workspace:WorkspaceView IsVisible="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
    <!-- 右侧远程文件面板：默认展开，只显示远程目录，点下载选本地目录，拖进来就上传 -->
    <GridSplitter x:Name="FileSplitter" Grid.Row="1" Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource BorderColor}" DragCompleted="FileSplitterDragCompleted" />
    <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,4,0" IsVisible="{Binding !IsFilePaneCollapsed}">
          <TextBlock Text="远程文件" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FilePane.Target}" FontSize="10" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePane.Target}" />
          <Button Name="RefreshFilePane" Classes="flat icon" Command="{Binding FilePane.RefreshCommand}" ToolTip.Tip="刷新远程文件" Width="26" Height="26">
            <controls:StrokeIcon Symbol="refresh" Width="16" Height="16" />
          </Button>
          <Button Name="CollapseFilePane" Classes="flat icon" Command="{Binding ToggleFilePaneCommand}" ToolTip.Tip="收起远程文件面板" Width="26" Height="26">
            <controls:StrokeIcon Symbol="chevron-right" Width="16" Height="16" />
          </Button>
        </StackPanel>
        <Button Name="ExpandFilePane" Classes="flat" IsVisible="{Binding IsFilePaneCollapsed}" Command="{Binding ToggleFilePaneCommand}"
                ToolTip.Tip="展开远程文件面板" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2">
          <controls:StrokeIcon Symbol="chevron-left" Width="16" Height="16" />
        </Button>
      </Grid>
    </Border>
    <Border Name="FilePaneHost" Grid.Row="1" Grid.Column="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0" IsVisible="{Binding !IsFilePaneCollapsed}">
      <browser:RemoteFilesPaneView x:Name="RemoteFilePane" DataContext="{Binding FilePane}" />
    </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="5" Background="{DynamicResource PrimaryBackground}"><Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryForeground}" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding SelectedTab.Address}" Foreground="{DynamicResource PrimaryForeground}" FontSize="11" Margin="18,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="SSH / SFTP    UTF-8" Foreground="{DynamicResource PrimaryForeground}" FontSize="11" VerticalAlignment="Center" /></Grid></Border>
  </Grid>
</Window>
