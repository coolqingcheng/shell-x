<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.Shell" x:DataType="vm:MainWindowViewModel"
        xmlns:workspace="using:ShellX.Desktop.Features.Workspace" xmlns:connections="using:ShellX.Desktop.Features.Connections"
        xmlns:monitor="using:ShellX.Desktop.Features.Monitoring" xmlns:controls="using:ShellX.Desktop.Controls"
        x:Class="ShellX.Desktop.Features.Shell.MainWindow" x:Name="Root"
        Title="ShellX" Icon="/Assets/ShellX.ico" Width="1380" Height="900" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewConnectionCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleConnectionsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding SelectedTab.CloseCommand}" />
  </Window.KeyBindings>
  <Grid x:Name="RootLayout" RowDefinitions="36,*,24" ColumnDefinitions="220,4,*">
    <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource RaisedBackground}" BorderThickness="0,0,1,1">
      <Grid ColumnDefinitions="*,Auto" Margin="12,0,6,0"><StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><Image Source="/Assets/ShellX.png" Width="18" Height="18" /><TextBlock Text="服务器状态" FontSize="12" /></StackPanel></Grid>
    </Border>
    <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="40,*,32,32,32">
        <Button Name="OpenConnectionManager" Classes="flat" Command="{Binding ToggleConnectionsCommand}" ToolTip.Tip="打开连接管理  Ctrl+B" Foreground="{DynamicResource AccentForeground}" Padding="7,0"><PathIcon Width="21" Height="19" Data="M2,4 L9,4 11,6 22,6 22,9 20,9 20,8 4,8 4,18 5,18 8,10 24,10 20,20 2,20 Z" /></Button>
        <ListBox Name="ConnectionTabs" Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="35" /></Style><Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AppBackground}" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate><DataTemplate x:DataType="workspace:WorkspaceTabViewModel"><controls:ConnectionAccentBorder Name="ConnectionTabBackground" Appearance="Tab" AccentColor="{Binding AccentColor}" IsActive="{Binding IsSelected}" BorderBrush="{DynamicResource RaisedBackground}" BorderThickness="0,0,1,0" MinWidth="130">
            <controls:ConnectionAccentBorder.ContextMenu>
              <ContextMenu><MenuItem Header="重命名标签…" Command="{Binding RenameCommand}" /><Separator /><MenuItem Header="关闭标签" Command="{Binding CloseCommand}" /></ContextMenu>
            </controls:ConnectionAccentBorder.ContextMenu>
            <Grid RowDefinitions="3,*"><controls:ConnectionAccentBorder Name="TabAccentLine" Appearance="Indicator" AccentColor="{Binding AccentColor}" IsHitTestVisible="False" /><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="9" Margin="10,1,3,1"><TextBlock Text="●" FontSize="8" Foreground="{Binding StatusColor}" VerticalAlignment="Center" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" /><Button Content="×" Classes="flat" Padding="4,2" Command="{Binding CloseCommand}" ToolTip.Tip="关闭标签" /></StackPanel></Grid></controls:ConnectionAccentBorder></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="2" Content="＋" Classes="flat" Command="{Binding NewConnectionCommand}" ToolTip.Tip="新建连接  Ctrl+N" Padding="4,0" FontSize="19" />
        <Button Name="ResetLayout" Grid.Column="3" Content="▦" Classes="flat" Command="{Binding ResetLayoutCommand}" ToolTip.Tip="恢复默认布局" Padding="4,0" FontSize="17" /><Button Grid.Column="4" Content="⚙" Classes="flat" Command="{Binding SettingsCommand}" ToolTip.Tip="设置" Padding="4,0" FontSize="17" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" Background="{DynamicResource PanelBackground}">
      <Border IsVisible="{Binding HasTabs}"><monitor:ServerMonitorView DataContext="{Binding SelectedTab.Monitor}" /></Border>
      <TextBlock IsVisible="{Binding HasNoTabs}" Text="连接后显示服务器状态" Foreground="{DynamicResource MutedForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <GridSplitter x:Name="MonitorSplitter" Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource BorderColor}" DragCompleted="MonitorSplitterDragCompleted" />
    <Grid Grid.Row="1" Grid.Column="2">
      <StackPanel IsVisible="{Binding HasNoTabs}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Spacing="20" Margin="32">
        <Image Source="/Assets/ShellX.png" Width="80" Height="80" Margin="0,0,0,8" HorizontalAlignment="Center" />
        <TextBlock Text="ShellX" FontSize="36" FontWeight="Light" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="终端、文件与服务器状态，集中在一个工作区。" Foreground="{DynamicResource MutedForeground}" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" />
        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,4" />
        <Button Content="打开连接管理器" Classes="primary" Command="{Binding ToggleConnectionsCommand}" HorizontalAlignment="Center" />
        <TextBlock Text="点击顶部文件夹管理连接，连接后左侧显示实时监控。" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock Text="密码 / 私钥认证 · 多标签 · SFTP · 端口转发" FontSize="11" Foreground="{DynamicResource PlaceholderForeground}" HorizontalAlignment="Center" TextAlignment="Center" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Tabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="workspace:WorkspaceTabViewModel"><workspace:WorkspaceView IsVisible="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#007ACC"><Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0"><TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding SelectedTab.Address}" Foreground="White" FontSize="11" Margin="18,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="SSH / SFTP    UTF-8" Foreground="White" FontSize="11" VerticalAlignment="Center" /></Grid></Border>
  </Grid>
</Window>
