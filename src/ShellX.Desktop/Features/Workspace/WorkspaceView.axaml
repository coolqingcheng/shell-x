<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.Workspace" x:DataType="vm:WorkspaceTabViewModel"
             xmlns:controls="using:ShellX.Desktop.Controls" xmlns:models="using:ShellX.Core.Commands"
             xmlns:commands="using:ShellX.Desktop.Features.Commands"
             xmlns:tunnels="using:ShellX.Desktop.Features.Tunnels" x:Class="ShellX.Desktop.Features.Workspace.WorkspaceView">
  <UserControl.Styles>
    <Style Selector="Border.flow">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.flow.active">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto">
    <Grid x:Name="WorkspaceLayout" RowDefinitions="*">
      <controls:ConnectionAccentBorder Name="TerminalAccentFrame" Appearance="Frame" AccentColor="{Binding AccentColor}" BorderThickness="2">
      <Grid RowDefinitions="30,*,Auto">
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,6,0" ColumnSpacing="12">
            <TextBlock Text="终端" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}" FontSize="10" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
              <Button x:Name="TunnelButton" Classes="flat" Foreground="{Binding TunnelStatusColor}" Command="{Binding ToggleTunnelsCommand}" ToolTip.Tip="{Binding TunnelTooltip}" Padding="6,3"><controls:StrokeIcon Symbol="tunnel" Width="18" Height="18" Foreground="{Binding TunnelStatusColor}" /></Button><Button Name="ToolbarServicesButton" Classes="flat" Padding="6,3" Click="OpenServices" IsEnabled="{Binding IsConnected}" ToolTip.Tip="查看服务器服务（systemctl）"><controls:StrokeIcon Symbol="service" Width="18" Height="18" /></Button><Button Name="ToolbarPortsButton" Classes="flat" Padding="6,3" Click="OpenPorts" IsEnabled="{Binding IsConnected}" ToolTip.Tip="查看端口占用（ss / netstat）"><controls:StrokeIcon Symbol="ports" Width="18" Height="18" /></Button><Button Name="OpenFileManagerButton" Classes="flat" Padding="6,3" Click="OpenFileManager" ToolTip.Tip="打开文件管理器（独立窗口）"><controls:StrokeIcon Symbol="folder" Width="18" Height="18" /></Button>
              <Button Classes="flat" Command="{Binding ReconnectCommand}" ToolTip.Tip="重新连接" IsEnabled="{Binding !IsConnecting}" Padding="6,3"><controls:StrokeIcon Symbol="refresh" Width="18" Height="18" /></Button>
              <Button Classes="flat" Command="{Binding DisconnectCommand}" ToolTip.Tip="断开连接" Padding="6,3"><controls:StrokeIcon Symbol="power" Width="18" Height="18" /></Button>
            </StackPanel>
          </Grid>
        </Border>
        <controls:TerminalHost x:Name="Terminal" Grid.Row="1" Channel="{Binding Terminal}" TerminalFontSize="{Binding FontSize}" TerminalFontFamily="{Binding FontFamily}" HighlightText="{Binding HighlightTerminalText}" />
        <Border Grid.Row="1" IsVisible="{Binding ShowOverlay}" Background="{DynamicResource AppBackground}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="500" Margin="24">
            <TextBlock Text="&gt;_" Foreground="{DynamicResource FaintForeground}" FontSize="32" FontFamily="Consolas" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryForeground}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsConnecting}" MinWidth="0" Width="180" Height="2" />
            <Button Content="重新连接" Classes="primary" Command="{Binding ReconnectCommand}" IsVisible="{Binding !IsConnecting}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="8,5">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
            <TextBox x:Name="CommandInput" Text="{Binding Commands.Input, Mode=TwoWay}" PlaceholderText="命令输入 · Enter 发送 · Alt+↑/↓ 历史" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource CommandForeground}" Padding="8,5" KeyDown="CommandKeyDown" ToolTip.Tip="{Binding Commands.Status}" />
            <Button x:Name="HistoryButton" Grid.Column="1" Content="历史" Classes="flat" FontSize="11" ToolTip.Tip="从最近发送的命令里选择">
              <Button.Flyout><Flyout>
                <StackPanel Width="440" Spacing="6" Margin="8">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="历史命令" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" Content="清空历史" Classes="flat" FontSize="11" Command="{Binding Commands.ClearHistoryCommand}" /></Grid>
                  <ScrollViewer MaxHeight="300"><ItemsControl ItemsSource="{Binding Commands.History}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="commands:CommandHistoryEntry">
                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="UseHistory" Tag="{Binding Text}"><TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" /></Button>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <TextBlock Text="点击填入命令输入框；历史只保留最近 200 条。" FontSize="10" Foreground="{DynamicResource MutedForeground}" />
                </StackPanel>
              </Flyout></Button.Flyout>
            </Button>
            <Button Grid.Column="2" Classes="flat" FontSize="11" ToolTip.Tip="常用命令：点击填入或执行，可添加、删除">
              <StackPanel Orientation="Horizontal" Spacing="5"><controls:StrokeIcon Symbol="command" Width="14" Height="14" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="常用命令" FontSize="11" VerticalAlignment="Center" /></StackPanel>
              <Button.Flyout><Flyout>
                <StackPanel Width="470" Spacing="6" Margin="8">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="常用命令" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="flat" FontSize="11" Command="{Binding Commands.AddQuickCommand}"><StackPanel Orientation="Horizontal" Spacing="5"><controls:StrokeIcon Symbol="plus" Width="12" Height="12" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="添加" FontSize="11" VerticalAlignment="Center" /></StackPanel></Button></Grid>
                  <ScrollViewer MaxHeight="300"><ItemsControl ItemsSource="{Binding Commands.QuickCommands}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:SavedCommand">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Margin="4,3">
                      <StackPanel Spacing="1"><TextBlock Text="{Binding Name}" FontSize="11" /><TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource CommandForeground}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" /></StackPanel>
                      <Button Grid.Column="1" Content="填入" Classes="flat" FontSize="11" Command="{Binding $parent[ItemsControl].((vm:WorkspaceTabViewModel)DataContext).Commands.FillCommand}" CommandParameter="{Binding Text}" />
                      <Button Grid.Column="2" Content="执行" Classes="flat" FontSize="11" Command="{Binding $parent[ItemsControl].((vm:WorkspaceTabViewModel)DataContext).Commands.ExecuteQuickCommand}" CommandParameter="{Binding}" />
                      <Button Grid.Column="3" Classes="flat" Padding="4,2" ToolTip.Tip="删除该常用命令" Command="{Binding $parent[ItemsControl].((vm:WorkspaceTabViewModel)DataContext).Commands.RemoveQuickCommand}" CommandParameter="{Binding}"><controls:StrokeIcon Symbol="close" Width="12" Height="12" /></Button>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  <TextBlock Text="点击“填入”放到输入框；“执行”立即发送；“添加”把输入框内容存成常用命令（随当前连接保存）。" FontSize="10" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
                </StackPanel>
              </Flyout></Button.Flyout>
            </Button>
            <Button Grid.Column="3" Content="发送" Classes="primary" Command="{Binding Commands.SendCommand}" FontSize="11" Padding="10,4" />
            <Button Grid.Column="4" Classes="flat" ToolTip.Tip="终端选项"><controls:StrokeIcon Symbol="more" Width="18" Height="18" />
              <Button.Flyout><MenuFlyout>
                <MenuItem Header="复制选中内容" Click="CopyTerminal" /><MenuItem Header="粘贴到终端" Click="PasteTerminal" /><MenuItem Header="清屏" Click="ClearTerminal" /><Separator />
                <MenuItem Header="终端进入文件面板当前目录" Command="{Binding TerminalDirectoryCommand}" /><MenuItem Header="放大字体" Command="{Binding IncreaseFontCommand}" /><MenuItem Header="缩小字体" Command="{Binding DecreaseFontCommand}" />
              </MenuFlyout></Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </Grid>
      </controls:ConnectionAccentBorder>
    </Grid>
    <Border x:Name="TunnelPanel" Grid.Column="1" IsVisible="{Binding ShowTunnels}" Width="300" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,8,6,8"><TextBlock Text="端口转发" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="flat" Command="{Binding ToggleTunnelsCommand}" ToolTip.Tip="收起端口转发" Padding="5,3"><controls:StrokeIcon Symbol="close" Width="16" Height="16" /></Button></Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="10,0,10,10">
            <Button Command="{Binding AddTunnelCommand}" Classes="primary" Padding="10,6"><StackPanel Orientation="Horizontal" Spacing="6"><controls:StrokeIcon Symbol="plus" Width="16" Height="16" Foreground="White" /><TextBlock Text="新建隧道" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Grid.Column="1" Name="StartAllTunnelsButton" Content="全部启动" Command="{Binding StartAllTunnelsCommand}" IsEnabled="{Binding IsConnected}" ToolTip.Tip="启动本连接所有未运行的转发规则" />
          </Grid>
        <TextBlock DockPanel.Dock="Bottom" Text="同一主机、SSH 端口和账号的标签共享隧道状态，可在任一标签启停；最后一个连接断开时释放。每 10 秒检测 TCP 可达性：绿色连通，红色失败，灰色停止。" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedForeground}" Margin="14" />
        <ScrollViewer><ItemsControl ItemsSource="{Binding Tunnels}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="tunnels:TunnelViewModel">
          <Border Padding="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"><StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" /></StackPanel><Button Grid.Column="2" Classes="flat" Padding="2" Command="{Binding RemoveCommand}" ToolTip.Tip="删除规则"><controls:StrokeIcon Symbol="close" Width="12" Height="12" /></Button></Grid>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" FontSize="11" />
            <TextBlock Text="{Binding Reason}" IsVisible="{Binding HasReason}" TextWrapping="Wrap" Foreground="{Binding StatusColor}" FontSize="11" />
            <TextBlock Text="{Binding CheckedText}" Foreground="{DynamicResource MutedForeground}" FontSize="10" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTraffic}" VerticalAlignment="Center">
              <Border Classes="flow" Classes.active="{Binding HasTraffic}" Padding="6,2" CornerRadius="2" Background="{DynamicResource ChartBackground}" ToolTip.Tip="端口转发现有数据经过">
                <controls:StrokeIcon Symbol="flow" Width="16" Height="16" StrokeThickness="1.4" Foreground="{DynamicResource SuccessForeground}" />
              </Border>
              <TextBlock Text="{Binding TrafficText}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}" /><Button Content="检测" Classes="flat" Command="{Binding CheckCommand}" /><Button Name="EditTunnelRule" Content="编辑" Classes="flat" Command="{Binding EditCommand}" /></StackPanel>
          </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
