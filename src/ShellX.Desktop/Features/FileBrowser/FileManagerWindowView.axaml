<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellX.Desktop.Features.Shell" xmlns:local="using:ShellX.Desktop.Features.FileBrowser"
             xmlns:controls="using:ShellX.Desktop.Controls"
             x:Class="ShellX.Desktop.Features.FileBrowser.FileManagerWindowView" x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="38,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <ListBox Name="FileTabs" ItemsSource="{Binding FileManagerTabs}" SelectedItem="{Binding SelectedFileManagerTab, Mode=TwoWay}" Classes="shelltabs">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:FileManagerTabViewModel">
            <controls:ShellTabItemView Title="{Binding Title}" StatusColor="{Binding StatusColor}" AccentColor="{Binding AccentColor}"
                                       IsActive="{Binding IsActive}" CloseCommand="{Binding CloseCommand}" CloseToolTip="关闭文件标签" TitleMaxWidth="190" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Column="1" Name="AddFileManagerTab" Classes="flat icon" Click="AddFileManagerTabClicked"
              IsEnabled="{Binding HasSelectedFileManagerTab}" ToolTip.Tip="为当前连接新建文件标签" Width="24" Height="24">
        <controls:StrokeIcon Symbol="plus" Width="16" Height="16" />
      </Button>
    </Grid>

    <ContentControl Grid.Row="1" Content="{Binding SelectedFileManagerTab}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="local:FileManagerTabViewModel">
          <local:FileBrowserView DataContext="{Binding Files}" />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Grid>
</UserControl>