<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellX.Desktop.Features.FileBrowser" x:DataType="vm:RemoteFilesPaneViewModel"
             xmlns:controls="using:ShellX.Desktop.Controls" xmlns:local="using:ShellX.Desktop.Features.FileBrowser"
             x:Class="ShellX.Desktop.Features.FileBrowser.RemoteFilesPaneView">
  <Grid RowDefinitions="32,*,Auto">
    <!-- 顶部：上一级 + 面包屑，点哪一段就跳到哪一层 -->
    <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2" Margin="4,0,6,0">
        <Button Grid.Column="0" Name="UpButton" Classes="flat icon" Command="{Binding UpCommand}" ToolTip.Tip="上一级"
                Width="26" Height="26" IsEnabled="{Binding CanGoUp}">
          <controls:StrokeIcon Symbol="up" Width="16" Height="16" />
        </Button>
        <controls:PathBar Grid.Column="1" Name="PathBar" Text="{Binding CurrentPath}" PlaceholderText="远程路径"
                          MaxVisibleSegments="3" NavigateRequested="PathNavigate" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Name="DropArea" Grid.Row="1" Background="{DynamicResource TreeBackground}">
      <Grid>
        <ScrollViewer Name="TreeList" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Entries}" Margin="4,2">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FileTreeNodeViewModel"><local:FileTreeNodeView /></DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ContextMenu>
              <ContextMenu>
                <MenuItem Header="下载到本地文件夹…" Click="DownloadClick" />
                <MenuItem Header="复制路径" Click="CopyPathClick" />
                <Separator />
                <MenuItem Header="刷新" Command="{Binding RefreshCommand}" />
              </ContextMenu>
            </ItemsControl.ContextMenu>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock IsVisible="{Binding !IsAvailable}" Text="连接服务器后，这里显示远程文件。"
                   Foreground="{DynamicResource PlaceholderForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="12" TextWrapping="Wrap" TextAlignment="Center" />
        <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" MinWidth="0" Height="2" VerticalAlignment="Top" />
      </Grid>
    </Border>

    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBackground}">
      <StackPanel Spacing="4">
        <Border IsVisible="{Binding HasError}" Background="{DynamicResource WarningBackground}" Padding="8,5" Margin="6,4">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningForeground}" FontSize="11" TextWrapping="Wrap" />
        </Border>
        <Grid ColumnDefinitions="*,Auto" Margin="8,4" ColumnSpacing="8" IsVisible="{Binding HasTransfer}">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding TransferText}" FontSize="11" TextTrimming="CharacterEllipsis" />
            <ProgressBar Value="{Binding TransferPercent}" Minimum="0" Maximum="100" Height="3" MinWidth="0" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding TransferPercent, StringFormat='{}{0:0}%'}" FontSize="11"
                     Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
