<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShellX.Desktop.Features.FileBrowser" x:DataType="vm:FileTreeNodeViewModel"
             xmlns:easing="using:Avalonia.Animation.Easings" xmlns:anim="using:Avalonia.Animation"
             xmlns:controls="using:ShellX.Desktop.Controls"
             x:Class="ShellX.Desktop.Features.FileBrowser.FileTreeNodeView"
             Height="26" IsVisible="{Binding IsVisible}">
  <!-- 出现动画只动渲染属性（透明度 + 位移），不动画行高：行高是布局属性，
       逐行过渡会让虚拟列表每帧重新测量，卡顿明显。这里一次布局都不触发。 -->
  <UserControl.Transitions>
    <anim:Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
    </anim:Transitions>
  </UserControl.Transitions>
  <UserControl.RenderTransform>
    <TranslateTransform>
      <TranslateTransform.Transitions>
        <anim:Transitions>
          <DoubleTransition Property="Y" Duration="0:0:0.2">
            <DoubleTransition.Easing>
              <easing:CubicEaseOut />
            </DoubleTransition.Easing>
          </DoubleTransition>
        </anim:Transitions>
      </TranslateTransform.Transitions>
    </TranslateTransform>
  </UserControl.RenderTransform>
  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
    </Style>
    <Style Selector="Border.row.current">
      <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
    </Style>
    <Style Selector="Border.row.droptarget">
      <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentForeground}" />
    </Style>
  </UserControl.Styles>
  <Border Name="Row" Classes="row" Classes.selected="{Binding IsSelected}" Classes.current="{Binding IsCurrent}"
          Classes.droptarget="{Binding IsDropTarget}"
          PointerPressed="RowPointerPressed" PointerMoved="RowPointerMoved" PointerReleased="RowPointerReleased"
          RightTapped="RowRightTapped">
    <Grid ColumnDefinitions="Auto,20,*,Auto,Auto,Auto" ColumnSpacing="6" Margin="{Binding RowMargin}">
      <Button Grid.Column="0" Name="Chevron" Command="{Binding ToggleCommand}" Classes="flat icon" Width="18" Height="18"
              MinWidth="0" MinHeight="0" Padding="0" IsVisible="{Binding ShowChevron}" ToolTip.Tip="展开 / 收起">
        <Panel Width="14" Height="14">
          <controls:StrokeIcon Symbol="chevron-right" Width="13" Height="13" IsVisible="{Binding !IsLoading}">
            <controls:StrokeIcon.RenderTransform>
              <RotateTransform Angle="{Binding ChevronAngle}">
                <RotateTransform.Transitions>
                  <anim:Transitions>
                    <DoubleTransition Property="Angle" Duration="0:0:0.18">
                      <DoubleTransition.Easing>
                        <easing:CubicEaseOut />
                      </DoubleTransition.Easing>
                    </DoubleTransition>
                  </anim:Transitions>
                </RotateTransform.Transitions>
              </RotateTransform>
            </controls:StrokeIcon.RenderTransform>
          </controls:StrokeIcon>
          <controls:BusySpinner IsVisible="{Binding IsLoading}" Stroke="{DynamicResource IconForeground}" Width="13" Height="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </Button>
      <Panel Grid.Column="1" Width="17" Height="17" VerticalAlignment="Center">
        <controls:FileIconView Symbol="{Binding Icon}" Classes.folder="{Binding IsDirectory}" Classes.link="{Binding IsLink}"
                               Width="17" Height="17" IsVisible="{Binding !IsDeleting}" />
        <controls:BusySpinner IsVisible="{Binding IsDeleting}" Stroke="{DynamicResource IconForeground}" Width="15" Height="15"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
      <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Path}" />
      <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource MutedForeground}"
                 VerticalAlignment="Center" MinWidth="58" TextAlignment="Right" />
      <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontSize="11" Foreground="{DynamicResource MutedForeground}"
                 VerticalAlignment="Center" MinWidth="98" IsVisible="{Binding !IsCompact}" />
      <!-- 行内下载：点了就弹出本地保存目录选择 -->
      <Button Grid.Column="5" Classes="flat icon" Command="{Binding DownloadItemCommand}" IsVisible="{Binding CanDownloadItem}"
              ToolTip.Tip="下载到本地文件夹" Width="22" Height="22" Padding="0" MinWidth="0" MinHeight="0">
        <controls:StrokeIcon Symbol="download" Width="14" Height="14" />
      </Button>
    </Grid>
  </Border>
</UserControl>
