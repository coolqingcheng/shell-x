<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.FileBrowser" x:DataType="vm:FileBrowserViewModel" xmlns:local="using:ShellX.Desktop.Features.FileBrowser"
             xmlns:controls="using:ShellX.Desktop.Controls" x:Class="ShellX.Desktop.Features.FileBrowser.RemoteFileBrowserView">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding UpCommand}" /><KeyBinding Gesture="F2" Command="{Binding RenameCommand}" /><KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
  </UserControl.KeyBindings>
  <Grid RowDefinitions="35,44,Auto,*,32">
    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Background="{DynamicResource PanelBackground}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0,4,0">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="远程" FontSize="11" /><TextBlock Text="SFTP" Foreground="{DynamicResource MutedForeground}" FontSize="10" /></StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsAvailable}">
            <Button Classes="flat" Command="{Binding NewFileCommand}" FontSize="11" Padding="8,5"><StackPanel Orientation="Horizontal" Spacing="5"><controls:StrokeIcon Symbol="plus" Width="15" Height="15" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="文件" FontSize="11" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="flat" Command="{Binding NewFolderCommand}" FontSize="11" Padding="8,5"><StackPanel Orientation="Horizontal" Spacing="5"><controls:StrokeIcon Symbol="plus" Width="15" Height="15" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="文件夹" FontSize="11" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Classes="flat" Command="{Binding DownloadCommand}" FontSize="11" Padding="8,5"><StackPanel Orientation="Horizontal" Spacing="5"><controls:StrokeIcon Symbol="download" Width="15" Height="15" Foreground="{DynamicResource ForegroundBrush}" /><TextBlock Text="下载" FontSize="11" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Content="编辑" Classes="flat" Command="{Binding EditTextCommand}" FontSize="11" />
            <Button Content="权限" Classes="flat" Command="{Binding PermissionsCommand}" FontSize="11" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
        <Button Classes="flat icon" ToolTip.Tip="更多操作" Width="28" Height="28"><controls:StrokeIcon Symbol="more" Width="20" Height="20" />
          <Button.Flyout><MenuFlyout>
            <MenuItem Header="选择文件上传…" Command="{Binding ChooseUploadCommand}" /><MenuItem Header="另存为…" Command="{Binding DownloadAsCommand}" /><Separator />
            <MenuItem Header="重命名    F2" Command="{Binding RenameCommand}" />
            <MenuItem Header="删除    Delete" Command="{Binding DeleteCommand}" />
            <Separator /><MenuItem Header="显示/隐藏隐藏文件" Command="{Binding ToggleHiddenCommand}" /><MenuItem Header="传输任务" Command="{Binding ToggleTransfersCommand}" />
          </MenuFlyout></Button.Flyout>
        </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="8,5" IsEnabled="{Binding IsAvailable}">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="flat icon" Command="{Binding BackCommand}" ToolTip.Tip="后退" Width="32" Height="32"><controls:StrokeIcon Symbol="back" Width="24" Height="24" /></Button><Button Classes="flat icon" Command="{Binding ForwardCommand}" ToolTip.Tip="前进" Width="32" Height="32"><controls:StrokeIcon Symbol="forward" Width="24" Height="24" /></Button><Button Classes="flat icon" Command="{Binding UpCommand}" ToolTip.Tip="上一级" Width="32" Height="32"><controls:StrokeIcon Symbol="up" Width="24" Height="24" /></Button><Button Classes="flat icon" Command="{Binding HomeCommand}" ToolTip.Tip="登录目录" Width="32" Height="32"><controls:StrokeIcon Symbol="home" Width="24" Height="24" /></Button><Button Classes="flat icon" Command="{Binding RefreshCommand}" ToolTip.Tip="刷新 F5" Width="32" Height="32"><controls:StrokeIcon Symbol="refresh" Width="24" Height="24" /></Button>
      </StackPanel>
      <controls:PathBar Grid.Column="1" Name="PathBar" Text="{Binding Path}" PlaceholderText="远程路径" VerticalAlignment="Center" NavigateRequested="PathNavigate" />
      <Button Grid.Column="2" x:Name="PathHistoryButton" Content="历史" Classes="flat" FontSize="11"><Button.Flyout><Flyout><ScrollViewer Width="350" MaxHeight="260"><ItemsControl ItemsSource="{Binding RecentPaths}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Button Content="{Binding}" Tag="{Binding}" Click="UsePathHistory" Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Flyout></Button.Flyout></Button>
    </Grid>
    <Border Grid.Row="2" IsVisible="{Binding HasError}" Background="{DynamicResource WarningBackground}" Padding="12,7"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningForeground}" FontSize="12" TextWrapping="Wrap" /></Border>
    <!-- 整个面板就是一棵树，展开的目录用动画铺开，滚动时只渲染视口内的行 -->
    <Grid Grid.Row="3">
      <ScrollViewer Name="TreeList" Background="{DynamicResource TreeBackground}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FlatNodes}" Margin="4,2">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileTreeNodeViewModel"><local:FileTreeNodeView /></DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.ContextMenu><ContextMenu>
            <MenuItem Header="打开" Command="{Binding OpenCommand}" /><MenuItem Header="编辑文本" Command="{Binding EditTextCommand}" /><MenuItem Header="查看日志…" Command="{Binding ViewLogCommand}" /><MenuItem Header="下载到左侧目录 ←" Command="{Binding DownloadCommand}" /><MenuItem Header="另存为…" Command="{Binding DownloadAsCommand}" /><Separator />
            <MenuItem Header="复制路径" Click="CopyPathClick" /><MenuItem Header="在终端打开" Command="{Binding OpenInTerminalCommand}" IsEnabled="{Binding SelectedIsDirectory}" /><Separator />
            <MenuItem Header="新建文件" Command="{Binding NewFileCommand}" /><MenuItem Header="新建文件夹" Command="{Binding NewFolderCommand}" />
            <MenuItem Header="重命名" Command="{Binding RenameCommand}" /><MenuItem Header="属性与权限" Command="{Binding PermissionsCommand}" />
            <Separator /><MenuItem Header="删除" Command="{Binding DeleteCommand}" />
          </ContextMenu></ItemsControl.ContextMenu>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock IsVisible="{Binding !IsAvailable}" Text="连接服务器后，在这里管理远程文件。" Foreground="{DynamicResource PlaceholderForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" MinWidth="0" Height="2" VerticalAlignment="Top" />
    </Grid>
    <Border Grid.Row="4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,125" ColumnSpacing="6" Margin="8,0"><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" /><CheckBox Grid.Column="1" Name="HiddenFilesToggle" Content="隐藏文件" IsChecked="{Binding ShowHidden, Mode=TwoWay}" FontSize="11" MinHeight="0" Height="28" Padding="8,0,0,0" Margin="0,0,4,0" VerticalAlignment="Center" /><TextBox Grid.Column="2" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="筛选远程文件" FontSize="11" Padding="6,2" MinHeight="0" Height="24" /></Grid>
    </Border>
  </Grid>
</UserControl>
