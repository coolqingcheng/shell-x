<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.FileBrowser" x:DataType="vm:DirectoryTreeNodeViewModel" xmlns:local="using:ShellX.Desktop.Features.FileBrowser" xmlns:easing="using:Avalonia.Animation.Easings" xmlns:anim="using:Avalonia.Animation" xmlns:controls="using:ShellX.Desktop.Controls"
             x:Class="ShellX.Desktop.Features.FileBrowser.DirectoryNodeView">
  <UserControl.Styles>
    <Style Selector="Border.nodeRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.nodeRow.current">
      <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <Grid ColumnDefinitions="22,*">
      <Button Command="{Binding ToggleCommand}" Classes="flat icon" MinWidth="0" Width="24" Height="24" ToolTip.Tip="展开 / 收起">
        <Panel Width="16" Height="16">
          <controls:StrokeIcon Symbol="chevron-right" Width="14" Height="14" IsVisible="{Binding !IsLoading}">
            <controls:StrokeIcon.RenderTransform>
              <RotateTransform Angle="{Binding ChevronAngle}">
                <RotateTransform.Transitions>
                  <anim:Transitions>
                    <DoubleTransition Property="Angle" Duration="0:0:0.18">
                      <DoubleTransition.Easing>
                        <easing:CubicEaseOut />
                      </DoubleTransition.Easing>
                    </DoubleTransition>
                  </anim:Transitions>
                </RotateTransform.Transitions>
              </RotateTransform>
            </controls:StrokeIcon.RenderTransform>
          </controls:StrokeIcon>
          <TextBlock Text="…" FontSize="11" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </Button>
      <Border Grid.Column="1" Classes="nodeRow" Classes.current="{Binding IsCurrent}" Margin="0,1">
        <Button Command="{Binding OpenCommand}" Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,4" ToolTip.Tip="{Binding Path}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <controls:StrokeIcon Symbol="folder" Width="16" Height="16" Foreground="{DynamicResource FolderForeground}" />
            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
      </Border>
    </Grid>
    <!-- 子节点区域：展开时淡入并下滑，折叠时淡出后隐藏 -->
    <Border Name="ChildrenHost" IsVisible="{Binding IsChildrenVisible}" Opacity="{Binding ExpandOpacity}" Margin="12,0,0,0" ClipToBounds="True">
      <Border.Transitions>
        <anim:Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.17">
            <DoubleTransition.Easing>
              <easing:CubicEaseOut />
            </DoubleTransition.Easing>
          </DoubleTransition>
        </anim:Transitions>
      </Border.Transitions>
      <Border.RenderTransform>
        <TranslateTransform Y="{Binding ExpandOffset}">
          <TranslateTransform.Transitions>
            <anim:Transitions>
              <DoubleTransition Property="Y" Duration="0:0:0.17">
                <DoubleTransition.Easing>
                  <easing:CubicEaseOut />
                </DoubleTransition.Easing>
              </DoubleTransition>
            </anim:Transitions>
          </TranslateTransform.Transitions>
        </TranslateTransform>
      </Border.RenderTransform>
      <ItemsControl ItemsSource="{Binding Children}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DirectoryTreeNodeViewModel">
            <local:DirectoryNodeView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </StackPanel>
</UserControl>
