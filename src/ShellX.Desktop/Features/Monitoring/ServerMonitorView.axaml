<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ShellX.Desktop.Features.Monitoring" x:DataType="vm:ServerMonitorViewModel" xmlns:controls="using:ShellX.Desktop.Controls"
             x:Class="ShellX.Desktop.Features.Monitoring.ServerMonitorView">
  <UserControl.Styles>
    <Style Selector="ProgressBar.meter"><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="3" /></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10,8" Spacing="9">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Hostname}" Foreground="{DynamicResource SuccessForeground}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Content="↻" Command="{Binding RefreshCommand}" Classes="flat" Padding="4,2" ToolTip.Tip="刷新监控" /></Grid>
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Address}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="复制" Classes="flat" FontSize="10" Padding="4,2" Click="CopyAddress" /></Grid>
      <Button Content="系统信息" Command="{Binding SystemInfoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="11" Padding="6,4" />
      <Grid ColumnDefinitions="38,*" RowDefinitions="Auto,Auto" RowSpacing="5"><TextBlock Text="运行" FontSize="11" Foreground="{DynamicResource MutedForeground}" /><TextBlock Grid.Column="1" Text="{Binding Uptime}" FontSize="11" /><TextBlock Grid.Row="1" Text="负载" FontSize="11" Foreground="{DynamicResource MutedForeground}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Load}" FontFamily="Consolas" FontSize="11" /></Grid>
      <StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="CPU" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="11" Foreground="{DynamicResource FolderForeground}" /></Grid><ProgressBar Classes="meter" Value="{Binding Cpu}" Foreground="{DynamicResource FolderForeground}" /></StackPanel>
      <StackPanel Spacing="4"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="内存" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontSize="10" HorizontalAlignment="Right" /></Grid><ProgressBar Classes="meter" Value="{Binding Memory}" Foreground="{DynamicResource AccentForeground}" /></StackPanel>
      <StackPanel Spacing="4"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="交换" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding SwapText}" FontSize="10" HorizontalAlignment="Right" /></Grid><ProgressBar Classes="meter" Value="{Binding Swap}" Foreground="{DynamicResource PurpleForeground}" /></StackPanel>
      <Border BorderBrush="{DynamicResource RaisedBackground}" BorderThickness="0,1,0,0" Margin="0,2,0,0" />
      <Grid ColumnDefinitions="46,40,42,*"><TextBlock Text="PID" FontSize="10" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" /><Button Name="SortCpu" Grid.Column="1" Content="{Binding CpuHeader}" Command="{Binding SortCpuCommand}" Classes="flat" FontSize="10" Padding="0,2" ToolTip.Tip="按 CPU 占用排序，点击切换升序 / 降序" /><Button Name="SortMemory" Grid.Column="2" Content="{Binding MemoryHeader}" Command="{Binding SortMemoryCommand}" Classes="flat" FontSize="10" Padding="0,2" ToolTip.Tip="按内存占比排序，点击切换升序 / 降序" /><TextBlock Grid.Column="3" Text="进程" FontSize="10" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" /></Grid>
      <ItemsControl ItemsSource="{Binding Processes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProcessRow"><Grid ColumnDefinitions="46,40,42,*" Margin="0,3" ToolTip.Tip="{Binding Description}"><TextBlock Text="{Binding Pid}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Cpu}" FontSize="10" Foreground="{DynamicResource FolderForeground}" /><TextBlock Grid.Column="2" Text="{Binding MemoryPercent}" FontSize="10" Foreground="{DynamicResource AccentForeground}" /><TextBlock Grid.Column="3" Text="{Binding Command}" FontSize="10" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="26" Padding="6,3" FontSize="11"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:NetworkViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding SelectedNetwork.Upload, StringFormat='↑ {0}'}" Foreground="{DynamicResource OrangeForeground}" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding SelectedNetwork.Download, StringFormat='↓ {0}'}" Foreground="{DynamicResource AccentForeground}" FontSize="10" HorizontalAlignment="Right" /></Grid>
      <controls:Sparkline Samples="{Binding SelectedNetwork.DownloadHistory}" SecondarySamples="{Binding SelectedNetwork.UploadHistory}" Height="62" ToolTip.Tip="最近 60 次采样 · 蓝色下载 / 橙色上传" />
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="SSH 响应" FontSize="10" Foreground="{DynamicResource MutedForeground}" /><TextBlock Grid.Column="1" Text="{Binding Response}" FontSize="10" Foreground="{DynamicResource SuccessForeground}" /></Grid>
      <controls:Sparkline Samples="{Binding ResponseHistory}" Stroke="{DynamicResource SuccessForeground}" Height="42" ToolTip.Tip="SSH 采样请求的完整响应时间" />
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="挂载路径" FontSize="10" Foreground="{DynamicResource MutedForeground}" /><TextBlock Grid.Column="1" Text="可用 / 总量" FontSize="10" Foreground="{DynamicResource MutedForeground}" /></Grid>
      <ItemsControl ItemsSource="{Binding Disks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DiskRow">
        <Button Command="{Binding $parent[UserControl].((vm:ServerMonitorViewModel)DataContext).OpenDiskCommand}" CommandParameter="{Binding}" Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,4" ToolTip.Tip="{Binding Description}">
          <StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Path}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Capacity}" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" /></Grid><ProgressBar Classes="meter" Value="{Binding UsedPercent}" Foreground="{DynamicResource CommentForeground}" /></StackPanel>
        </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,4" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
