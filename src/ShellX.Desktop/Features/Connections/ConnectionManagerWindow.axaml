<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShellX.Desktop.Features.Shell" xmlns:connections="using:ShellX.Desktop.Features.Connections"
        x:DataType="vm:MainWindowViewModel" x:Class="ShellX.Desktop.Features.Connections.ConnectionManagerWindow"
        Title="连接管理器" Width="900" Height="620" MinWidth="720" MinHeight="440" WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewConnectionCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="*,Auto">
    <connections:ConnectionManagerView />
    <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0">
      <Button Content="关闭" Click="CloseWindow" HorizontalAlignment="Right" Margin="16,10" MinWidth="88" />
    </Border>
  </Grid>
</Window>