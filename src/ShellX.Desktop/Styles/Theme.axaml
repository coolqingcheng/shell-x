<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:ShellX.Desktop.Controls">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI,Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- 主按钮与焦点描边跟随主题主色，不再固定成 VS Code 蓝 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBackground}" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="MinWidth" Value="28" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <!-- 图标按钮：整体是正方形，悬浮背景铺满整个按钮，不会和相邻元素挤在一起 -->
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.activity">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
  </Style>
  <!-- 线条图标：控件自带 Foreground；文件夹和链接用主题色，普通文件与工具栏图标用中性图标色。 -->
  <Style Selector="controls|StrokeIcon">
    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
  </Style>
  <Style Selector="controls|FileIconView">
    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
  </Style>
  <Style Selector="controls|FileIconView.folder">
    <Setter Property="Foreground" Value="{DynamicResource FolderForeground}" />
  </Style>
  <Style Selector="controls|FileIconView.link">
    <Setter Property="Foreground" Value="{DynamicResource LinkForeground}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <!-- 输入框文字垂直居中 -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RaisedBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="TextBox.file-path">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentForeground}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <!-- 下拉框文字垂直居中 -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 浮层：右键菜单外框用中圆角，菜单项与下拉项用小圆角，弹层不再是直角方块 -->
  <Style Selector="ContextMenu">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <!-- 卡片容器：独立区块（面板、列表分组）用中圆角 + 主题描边，跟内容区区分开 -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- 勾选框：方框也带上一点点圆角，和整体圆角风格一致 -->
  <Style Selector="CheckBox">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Expander.connectionGroup">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="RowHeight" Value="30" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBackground}" />
  </Style>
  <Style Selector="Border.flow">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Border.flow.active">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.4" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <!-- 选中态统一圆角：列表与树的选中块不再是硬邦邦的直角方块 -->
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <!-- 标签栏：终端、文件管理器、文本编辑器统一使用同一套列表样式 -->
  <Style Selector="ListBox.shelltabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.shelltabs ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="MinHeight" Value="35" />
  </Style>
</Styles>
