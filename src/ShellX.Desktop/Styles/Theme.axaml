<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground">#1E1E1E</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#252526</SolidColorBrush>
          <SolidColorBrush x:Key="BorderColor">#333333</SolidColorBrush>
          <SolidColorBrush x:Key="ForegroundBrush">#CCCCCC</SolidColorBrush>
          <SolidColorBrush x:Key="EditorForeground">#D4D4D4</SolidColorBrush>
          <SolidColorBrush x:Key="RaisedBackground">#3C3C3C</SolidColorBrush>
          <SolidColorBrush x:Key="InputBackground">#3C3C3C</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBackground">#2D2D30</SolidColorBrush>
          <SolidColorBrush x:Key="HoverBackground">#37373D</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBackground">#094771</SolidColorBrush>
          <SolidColorBrush x:Key="MutedForeground">#858585</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryForeground">#9D9D9D</SolidColorBrush>
          <SolidColorBrush x:Key="IconForeground">#969696</SolidColorBrush>
          <SolidColorBrush x:Key="PlaceholderForeground">#666666</SolidColorBrush>
          <SolidColorBrush x:Key="FaintForeground">#555555</SolidColorBrush>
          <SolidColorBrush x:Key="AccentForeground">#4FC1FF</SolidColorBrush>
          <SolidColorBrush x:Key="LinkForeground">#75BEFF</SolidColorBrush>
          <SolidColorBrush x:Key="FolderForeground">#D7BA7D</SolidColorBrush>
          <SolidColorBrush x:Key="CommandForeground">#DCDCAA</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessForeground">#73C991</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorForeground">#F48771</SolidColorBrush>
          <SolidColorBrush x:Key="WarningForeground">#F4B894</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackground">#332823</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBackground">#20382B</SolidColorBrush>
          <SolidColorBrush x:Key="TreeBackground">#222223</SolidColorBrush>
          <SolidColorBrush x:Key="ChartBackground">#202022</SolidColorBrush>
          <SolidColorBrush x:Key="ChartGrid">#353539</SolidColorBrush>
          <SolidColorBrush x:Key="PurpleForeground">#C586C0</SolidColorBrush>
          <SolidColorBrush x:Key="OrangeForeground">#CE9178</SolidColorBrush>
          <SolidColorBrush x:Key="CommentForeground">#608B4E</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#F3F3F3</SolidColorBrush>
          <SolidColorBrush x:Key="BorderColor">#D4D4D4</SolidColorBrush>
          <SolidColorBrush x:Key="ForegroundBrush">#333333</SolidColorBrush>
          <SolidColorBrush x:Key="EditorForeground">#242424</SolidColorBrush>
          <SolidColorBrush x:Key="RaisedBackground">#E5E5E5</SolidColorBrush>
          <SolidColorBrush x:Key="InputBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBackground">#EAEAEA</SolidColorBrush>
          <SolidColorBrush x:Key="HoverBackground">#E1E1E1</SolidColorBrush>
          <SolidColorBrush x:Key="SelectionBackground">#CCE8FF</SolidColorBrush>
          <SolidColorBrush x:Key="MutedForeground">#666666</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryForeground">#595959</SolidColorBrush>
          <SolidColorBrush x:Key="IconForeground">#5F5F5F</SolidColorBrush>
          <SolidColorBrush x:Key="PlaceholderForeground">#767676</SolidColorBrush>
          <SolidColorBrush x:Key="FaintForeground">#8A8A8A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentForeground">#006AB1</SolidColorBrush>
          <SolidColorBrush x:Key="LinkForeground">#005FB8</SolidColorBrush>
          <SolidColorBrush x:Key="FolderForeground">#8A6100</SolidColorBrush>
          <SolidColorBrush x:Key="CommandForeground">#795E00</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessForeground">#16723C</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorForeground">#BF2020</SolidColorBrush>
          <SolidColorBrush x:Key="WarningForeground">#8A3C12</SolidColorBrush>
          <SolidColorBrush x:Key="WarningBackground">#FFF1DE</SolidColorBrush>
          <SolidColorBrush x:Key="SuccessBackground">#E4F3E7</SolidColorBrush>
          <SolidColorBrush x:Key="TreeBackground">#F7F7F7</SolidColorBrush>
          <SolidColorBrush x:Key="ChartBackground">#FAFAFA</SolidColorBrush>
          <SolidColorBrush x:Key="ChartGrid">#DDDDDD</SolidColorBrush>
          <SolidColorBrush x:Key="PurpleForeground">#8228A1</SolidColorBrush>
          <SolidColorBrush x:Key="OrangeForeground">#A5451B</SolidColorBrush>
          <SolidColorBrush x:Key="CommentForeground">#477A30</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI,Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#007ACC" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#168BD2" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="MinWidth" Value="28" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBackground}" />
  </Style>
  <Style Selector="Button.activity">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
  </Style>
  <!-- 文件列表图标：StyleKey 指向 PathIcon，这里按标记类配色；文件夹和链接用主题色，普通文件用中性图标色。 -->
  <Style Selector="PathIcon.file-icon">
    <Setter Property="Foreground" Value="{DynamicResource IconForeground}" />
  </Style>
  <Style Selector="PathIcon.file-icon.folder">
    <Setter Property="Foreground" Value="{DynamicResource FolderForeground}" />
  </Style>
  <Style Selector="PathIcon.file-icon.link">
    <Setter Property="Foreground" Value="{DynamicResource LinkForeground}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RaisedBackground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="TextBox.file-path">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="#007ACC" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBackground}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Expander.connectionGroup">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="RowHeight" Value="30" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SelectionBackground}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
</Styles>
