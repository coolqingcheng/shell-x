<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <ShellXVersionFile Condition="'$(ShellXVersionFile)' == '' And Exists('$(MSBuildThisFileDirectory)VERSION')">$(MSBuildThisFileDirectory)VERSION</ShellXVersionFile>
    <ShellXVersion Condition="'$(ShellXVersion)' == '' And '$(ShellXVersionFile)' != ''">$([System.IO.File]::ReadAllText('$(ShellXVersionFile)').Trim())</ShellXVersion>
    <ShellXVersion Condition="'$(ShellXVersion)' == ''">1.0.0</ShellXVersion>
    <Version>$(ShellXVersion)</Version>
    <AssemblyVersion>$(ShellXVersion)</AssemblyVersion>
    <FileVersion>$(ShellXVersion).0</FileVersion>
    <Product>ShellX</Product>
    <AssemblyTitle>ShellX</AssemblyTitle>
  </PropertyGroup>
</Project>
